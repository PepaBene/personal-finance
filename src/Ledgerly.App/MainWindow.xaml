<Window
    x:Class="Ledgerly.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Ledgerly">

    <Grid>
        <!-- App shell, hidden until unlocked -->
        <muxc:NavigationView
            x:Name="Nav"
            Visibility="Collapsed"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="OnNavSelectionChanged"
            PaneDisplayMode="Left">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Dashboard" Tag="Dashboard" IsSelected="True" />
                <muxc:NavigationViewItem Content="Transactions" Tag="Transactions" />
                <muxc:NavigationViewItem Content="Accounts" Tag="Accounts" />
                <muxc:NavigationViewItem Content="Categories" Tag="Categories" />
                <muxc:NavigationViewItem Content="Analytics" Tag="Analytics" />
                <muxc:NavigationViewItem Content="Settings" Tag="Settings" />
            </muxc:NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </muxc:NavigationView>

        <!-- Lock screen (docs/06 §2.1) -->
        <StackPanel
            x:Name="LockPanel"
            MaxWidth="360"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12">
            <TextBlock Text="Ledgerly" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock x:Name="LockPrompt" TextWrapping="Wrap" HorizontalAlignment="Center" />
            <PasswordBox x:Name="PasswordInput" PlaceholderText="Master password" />
            <Button x:Name="UnlockButton" Content="Unlock" HorizontalAlignment="Stretch" Click="OnUnlockClicked" />
            <TextBlock x:Name="LockError" Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock
                TextWrapping="Wrap"
                Opacity="0.7"
                FontSize="12"
                Text="There is no password recovery. Keep your password and a backup safe." />
        </StackPanel>
    </Grid>
</Window>
