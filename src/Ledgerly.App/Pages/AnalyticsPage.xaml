<Page
    x:Class="Ledgerly.App.Pages.AnalyticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="900">
            <TextBlock Text="Analytics" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Opacity="0.7"
                TextWrapping="Wrap"
                Text="Lightweight bar charts drawn with WinUI primitives. LiveCharts2 can be dropped in for richer, animated charts on a Windows dev machine." />

            <TextBlock Text="Spend by category (this year)" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel x:Name="CategoryBars" Spacing="6" />

            <TextBlock Text="Income vs expense by month" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel x:Name="MonthBars" Spacing="12" />
        </StackPanel>
    </ScrollViewer>
</Page>
