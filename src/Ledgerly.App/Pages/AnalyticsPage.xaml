<Page
    x:Class="Ledgerly.App.Pages.AnalyticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="900">
            <TextBlock Text="Analytics" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Opacity="0.7"
                TextWrapping="Wrap"
                Text="Tabular MVP. Charts (LiveCharts2) are a follow-up." />

            <TextBlock Text="Spend by category (this year)" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView x:Name="CategorySpendList" SelectionMode="None" />

            <TextBlock Text="Income vs expense by month" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView x:Name="OverTimeList" SelectionMode="None" />
        </StackPanel>
    </ScrollViewer>
</Page>
