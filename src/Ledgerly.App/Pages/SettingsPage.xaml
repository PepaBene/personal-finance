<Page
    x:Class="Ledgerly.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="720">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Base currency" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="BaseCurrencyText" VerticalAlignment="Center" />
                        <TextBox x:Name="BaseCurrencyBox" Width="90" PlaceholderText="EUR" />
                        <Button Content="Set" Click="OnSetBaseCurrency" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Backup &amp; restore" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox x:Name="BackupPathBox" Header="File path" PlaceholderText="C:\path\to\ledgerly-backup.db" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Back up now" Click="OnBackup" />
                        <Button Content="Restore" Click="OnRestore" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="CSV import / export" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox x:Name="CsvPathBox" Header="File path" PlaceholderText="C:\path\to\transactions.csv" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Export CSV" Click="OnExportCsv" />
                        <Button Content="Import CSV" Click="OnImportCsv" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8" />
        </StackPanel>
    </ScrollViewer>
</Page>
